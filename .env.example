# Public BFF origin for the mobile client.
EXPO_PUBLIC_API_URL=https://hng-shop-task.vercel.app/api/v1

# Catalogue data source: "fixtures" for offline development, "api" for the deployed BFF.
EXPO_PUBLIC_CATALOGUE_SOURCE=fixtures

# Supabase project URL and publishable key. Both are client-safe by design.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional fixed OAuth/payment redirect. Defaults to the app scheme from app.json.
# Register the resolved value in the Supabase Auth redirect allowlist.
EXPO_PUBLIC_AUTH_REDIRECT_URL=

# Never add these to this repository. They belong on the backend only:
# SUPABASE_SERVICE_ROLE_KEY, PAYSTACK_SECRET_KEY, PAYSTACK_WEBHOOK_SECRET,
# MAILGUN_API_KEY, MAILGUN_DOMAIN, MAILGUN_FROM_EMAIL, MAILGUN_API_BASE_URL
