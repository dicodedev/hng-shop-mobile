{
  "name": "hng-shop-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "generate:api": "openapi-typescript docs/api/openapi.yaml -o src/api/generated/schema.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit --runInBand",
    "test:watch": "jest --selectProjects unit --watch",
    "test:contract": "jest --selectProjects contract --runInBand",
    "export": "expo export --platform all"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/query-async-storage-persister": "^5.90.2",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-persist-client": "^5.90.2",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "jest-expo",
        "setupFilesAfterEnv": [
          "<rootDir>/src/test/setup.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/.expo/",
          "\\.contract\\.ts$"
        ]
      },
      {
        "displayName": "contract",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/src/**/*.contract.ts"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        },
        "transform": {
          "^.+\\.[jt]sx?$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ]
            }
          ]
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(\\.pnpm/)?(expo|@expo))"
        ]
      }
    ]
  }
}
